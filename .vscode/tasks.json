{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (g++ C++17)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-O2",
        "-g",
        "-Wall",
        "-Wextra",
        "main.cpp",
        "library_system.cpp",
        "-o",
        "MiniLibrarySystemApp.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
